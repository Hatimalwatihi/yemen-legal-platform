# Google Gemini / AI
GEMINI_API_KEY=

# Firebase Admin (optional when using local JSON fallback)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Secure first administrator bootstrap. Never commit real values.
# Password must be at least 12 characters.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Registration invitation code. Use a long random value.
LEGAL_INVITE_CODE=CHANGE_THIS_TO_A_LONG_RANDOM_INVITE

PORT=3000

# Comma-separated client origins. For Capacitor APK commonly: https://localhost
CORS_ORIGINS=https://localhost
